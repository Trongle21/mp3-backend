### =====================================================
###   Music App Backend — API test file (.http / REST Client)
###   Dùng extension VSCode "REST Client" hoặc IntelliJ HTTP Client
### =====================================================

@baseUrl = http://localhost:5000/api

### ========== AUTH ==========

### Register
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "secret123",
  "name": "Tester"
}

### Login
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "secret123"
}

###
@accessToken = {{login.response.body.data.accessToken}}
@refreshToken = {{login.response.body.data.refreshToken}}
@userId = {{login.response.body.data.user._id}}

### Get current user
GET {{baseUrl}}/auth/me
Authorization: Bearer {{accessToken}}

### Refresh access token
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}


### ========== TRACKS ==========

### Upload a track (file is required as multipart/form-data, key: file)
POST {{baseUrl}}/tracks/upload
Authorization: Bearer {{accessToken}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="file"; filename="song.mp3"
Content-Type: audio/mpeg

< ./sample.mp3
--boundary
Content-Disposition: form-data; name="title"

My Custom Title
--boundary
Content-Disposition: form-data; name="artist"

Custom Artist
--boundary--

### List tracks (with search & sort & pagination)
GET {{baseUrl}}/tracks?page=1&limit=20&sort=createdAt&search=
Authorization: Bearer {{accessToken}}

### Get one track
GET {{baseUrl}}/tracks/{{trackId}}
Authorization: Bearer {{accessToken}}

### Update metadata
PATCH {{baseUrl}}/tracks/{{trackId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "title": "Renamed",
  "artist": "Updated Artist"
}

### Stream track (NO Range — server trả toàn bộ file)
GET {{baseUrl}}/tracks/{{trackId}}/stream
Authorization: Bearer {{accessToken}}

### Stream track với Range (200KB đầu) — phải trả 206 + Content-Range
GET {{baseUrl}}/tracks/{{trackId}}/stream
Authorization: Bearer {{accessToken}}
Range: bytes=0-204799

### Stream track từ giây thứ 30 (với duration ~180s, ~3MB, ~17KB/s => 510KB)
GET {{baseUrl}}/tracks/{{trackId}}/stream
Authorization: Bearer {{accessToken}}
Range: bytes=510000-1023999

### Delete track
DELETE {{baseUrl}}/tracks/{{trackId}}
Authorization: Bearer {{accessToken}}


### ========== GROUPS / PLAYLISTS ==========

### Create group
# @name group
POST {{baseUrl}}/groups
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "My Favorites"
}

###
@groupId = {{group.response.body.data._id}}

### List groups
GET {{baseUrl}}/groups
Authorization: Bearer {{accessToken}}

### Get group details (with tracks populated)
GET {{baseUrl}}/groups/{{groupId}}
Authorization: Bearer {{accessToken}}

### Rename group
PATCH {{baseUrl}}/groups/{{groupId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Renamed Playlist"
}

### Add track to group
POST {{baseUrl}}/groups/{{groupId}}/tracks
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "trackId": "{{trackId}}"
}

### Reorder tracks in group
PATCH {{baseUrl}}/groups/{{groupId}}/reorder
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "trackIds": ["{{trackId}}"]
}

### Remove track from group
DELETE {{baseUrl}}/groups/{{groupId}}/tracks/{{trackId}}
Authorization: Bearer {{accessToken}}

### Delete group
DELETE {{baseUrl}}/groups/{{groupId}}
Authorization: Bearer {{accessToken}}


### ========== PLAYER STATE ==========

### Get player state
GET {{baseUrl}}/player/state
Authorization: Bearer {{accessToken}}

### Update player state (vd: play track ở 30s)
PATCH {{baseUrl}}/player/state
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "currentTrack": "{{trackId}}",
  "positionSec": 30,
  "isPlaying": true,
  "repeatMode": "all",
  "shuffle": false,
  "queue": []
}

### Update player state — chỉ đổi isPlaying
PATCH {{baseUrl}}/player/state
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "isPlaying": false,
  "positionSec": 0
}


### ========== CHAT & CONVERSATIONS ==========

### Create direct conversation (1-1)
# @name createDirectConv
POST {{baseUrl}}/conversations
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "type": "direct",
  "recipientId": "66e000000000000000000002"
}

###
@convId = {{createDirectConv.response.body.data._id}}

### Create group conversation
POST {{baseUrl}}/conversations
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "type": "group",
  "name": "Nhóm Chat Âm Nhạc",
  "memberIds": ["66e000000000000000000002"]
}

### List conversations
GET {{baseUrl}}/conversations?page=1&limit=20
Authorization: Bearer {{accessToken}}

### Get conversation details
GET {{baseUrl}}/conversations/{{convId}}
Authorization: Bearer {{accessToken}}

### Update group name
PATCH {{baseUrl}}/conversations/{{convId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Nhóm Chat Cập Nhật"
}

### Add member to group
POST {{baseUrl}}/conversations/{{convId}}/members
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "userId": "66e000000000000000000003"
}

### Kick / Leave group
DELETE {{baseUrl}}/conversations/{{convId}}/members/66e000000000000000000003
Authorization: Bearer {{accessToken}}

### Get chat media upload URL (for image/audio/gif)
POST {{baseUrl}}/conversations/{{convId}}/upload-url
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "filename": "photo.jpg",
  "mimeType": "image/jpeg"
}


### ========== MESSAGES ==========

### Send text message
# @name sendMsg
POST {{baseUrl}}/conversations/{{convId}}/messages
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "type": "text",
  "content": "Xin chào! Bài hát này hay quá!"
}

###
@msgId = {{sendMsg.response.body.data._id}}

### List messages (cursor pagination)
GET {{baseUrl}}/conversations/{{convId}}/messages?limit=30
Authorization: Bearer {{accessToken}}

### Edit message
PATCH {{baseUrl}}/conversations/{{convId}}/messages/{{msgId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "content": "Xin chào! Bài hát này cực kỳ hay!"
}

### React to message
POST {{baseUrl}}/conversations/{{convId}}/messages/{{msgId}}/react
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "emoji": "❤️"
}

### Mark conversation as read
POST {{baseUrl}}/conversations/{{convId}}/messages/read
Authorization: Bearer {{accessToken}}

### Delete message (soft delete)
DELETE {{baseUrl}}/conversations/{{convId}}/messages/{{msgId}}
Authorization: Bearer {{accessToken}}


### ========== CONTACTS & PRESENCE ==========

### List accepted contacts
GET {{baseUrl}}/users/contacts
Authorization: Bearer {{accessToken}}

### List pending contact requests
GET {{baseUrl}}/users/contacts?status=pending
Authorization: Bearer {{accessToken}}

### Send contact request
POST {{baseUrl}}/users/contacts
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "recipientId": "66e000000000000000000002"
}

### Accept contact request
PATCH {{baseUrl}}/users/contacts/66e000000000000000000099
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "action": "accept"
}

### Query presence for multiple users
GET {{baseUrl}}/users/presence?userIds=66e000000000000000000002,{{userId}}
Authorization: Bearer {{accessToken}}

### Send heartbeat
POST {{baseUrl}}/users/presence/heartbeat
Authorization: Bearer {{accessToken}}

